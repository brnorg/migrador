{
  "name": "bladelogic-runner",
  "displayName": "BladeLogic Runner",
  "description": "Le arquivos bladeLogic.xml pelo menu de contexto e mostra a analise no terminal.",
  "version": "0.0.1",
  "publisher": "local",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:bladelogicRunner.analyzeFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bladelogicRunner.analyzeFile",
        "title": "🔥 Extrair servidores do bladeLogic.xml 🔥"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bladelogicRunner.analyzeFile",
          "when": "resourceFilename =~ /^bladelogic\\.xml$/i",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run lint",
    "lint": "node --check extension.js && node --check analyzer/bladeLogicAnalyzer.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
