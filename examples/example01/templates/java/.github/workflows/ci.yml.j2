name: CI

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "{{ runtime_version }}"
      - name: Show branch
        run: echo "Running on ${{ github.ref_name }}"
      - name: Build {{ project_name }}
        run: mvn -B test
